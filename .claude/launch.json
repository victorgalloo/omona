{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:dashboard"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dashboard-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:verify",
        "--workspace=apps/dashboard"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
