# ── Omona Dashboard — variables de entorno (Vercel) ──

# Supabase. Sin estas, lib/supabase.ts usa un placeholder y el login falla
# en silencio; auth/confirm/route.ts las lee con `!` y revienta.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública del server (Railway). Default en código: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública del sitio — la leen robots.ts, sitemap.ts y layout.tsx.
# Si falta, robots.ts y sitemap.ts caen a dominios distintos entre sí.
NEXT_PUBLIC_SITE_URL=https://omona.tech

# PostHog. PostHogProvider hace posthog.init(...!) sin guard.
# El host va fijo a '/ingest' (rewrite en next.config), no por env.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
