# ─────────────────────────────────────────────────────────────────────────────
# Omona · servidor (Hono). Copia este archivo a .env y llena lo obligatorio.
#
# En producción este archivo vive en el EC2, en /opt/omona/.env
# (NO en /opt/omona/app/), y lo lee docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBLIGATORIAS ─────────────────────────────────────────────────────────────
# Sin estas tres el servidor no arranca: config.ts las exige con .min(1).

# Supabase → Project Settings → API
# La service key salta RLS: es de servidor, nunca la pongas en el dashboard.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Modelo de IA. Producción corre OpenAI directo (platform.openai.com/api-keys).
# La API es compatible con OpenAI, así que para cambiar de proveedor —Azure,
# Bedrock, Z.ai, cualquier gateway— basta con cambiar estas tres.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra

# ── NECESARIAS EN PRODUCCIÓN ─────────────────────────────────────────────────

# Origen permitido por CORS. Si no coincide con el dominio real del dashboard,
# el navegador bloquea TODAS las llamadas a la API.
DASHBOARD_URL=https://omona.tech

# Correo transaccional (confirmación de cuenta, invitaciones, recordatorios).
# resend.com/api-keys. El dominio de EMAIL_FROM_ADDRESS debe estar verificado
# en Resend con DKIM y SPF, o Resend rechaza el envío.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hola@omona.tech
EMAIL_FROM_NAME=Omona

# ── OPCIONALES ───────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=production

# WhatsApp por Baileys (número personal, se vincula con QR desde el dashboard).
# Es el modo por defecto de cada organización.
BAILEYS_AUTH_DIR=./auth_sessions

# WhatsApp Cloud API (número oficial de Meta). Sólo si alguna organización
# usa whatsapp_provider = 'cloud_api'.
#
# WHATSAPP_APP_SECRET verifica la firma de los webhooks entrantes de Meta.
# Vacío = se aceptan webhooks sin verificar la firma. Ponlo antes de usar
# Cloud API en serio.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=omona-verify-token

# Notificaciones push a iOS. No hay app iOS en este repo todavía; mientras
# estén vacías, el envío de push simplemente no hace nada.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.anthana.omona-ios
APNS_SANDBOX=
