# ── Omona Server — variables de entorno (Railway) ──

PORT=3001
NODE_ENV=production

# Supabase (proyecto nuevo de la org Anthana)
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role...

# AI model — Azure AI Model Inference (OpenAI-compatible)
AI_BASE_URL=https://tu-endpoint.services.ai.azure.com/models
AI_API_KEY=tu-api-key
AI_MODEL=grok-4-1-fast-reasoning-2

# Baileys — sesiones de WhatsApp (montar como volumen en Railway)
BAILEYS_AUTH_DIR=./auth_sessions

# WhatsApp Cloud API (canal oficial, dual-mode)
# App secret de la Meta App (para verificar firma del webhook)
WHATSAPP_APP_SECRET=
# Token que pones al registrar el webhook en Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=omona-verify-token

# Dashboard (para CORS)
DASHBOARD_URL=https://omona.tech

# Resend (notificaciones email, opcional)
RESEND_API_KEY=

# Supabase Auth Hook secret (opcional)
SUPABASE_HOOK_SECRET=

# Apple Push Notifications (opcional)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.anthana.omona-ios
APNS_SANDBOX=
