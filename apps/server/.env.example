# ── Omona Server — variables de entorno (Railway) ──

PORT=3001
NODE_ENV=production

# ── OBLIGATORIAS ──
# config.ts hace envSchema.parse(process.env): sin estas el proceso no arranca.

# Supabase (proyecto de la org Anthana)
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role...

# AI model — Azure AI Model Inference (OpenAI-compatible)
AI_API_KEY=tu-api-key

# ── Con default en config.ts, pero conviene fijarlas ──

AI_BASE_URL=https://TU-RECURSO.services.ai.azure.com/openai/v1
AI_MODEL=gpt-5-4-mini

# Baileys — sesiones de WhatsApp.
# En Railway apuntar al path del volumen montado (./auth_sessions es efímero).
BAILEYS_AUTH_DIR=./auth_sessions

# Groq — transcripción de audios de WhatsApp (whisper-large-v3).
# Si falta, los audios entrantes se descartan (solo logger.warn).
GROQ_API_KEY=

# Dashboard (para CORS). Default: http://localhost:3000
DASHBOARD_URL=https://omona.tech

# ── WhatsApp Cloud API (canal oficial, dual-mode) ──
# App secret de la Meta App. Sin esto NO se verifica la firma del webhook.
WHATSAPP_APP_SECRET=
# Debe coincidir con el token registrado en el Meta App Dashboard.
WHATSAPP_VERIFY_TOKEN=omona-verify-token

# ── OPCIONALES (la feature queda desactivada si faltan) ──

# Resend (notificaciones email)
RESEND_API_KEY=

# Remitente de todos los correos. El dominio DEBE estar verificado en Resend:
# si no lo está, Resend rechaza el envío y los correos nunca salen.
EMAIL_FROM_ADDRESS=hola@omona.tech
EMAIL_FROM_NAME=Omona

# Supabase Auth Hook secret (verificación del hook send_email)
SUPABASE_HOOK_SECRET=

# Apple Push Notifications
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.anthana.omona-ios
APNS_SANDBOX=
