# ── /opt/omona/.env — server en EC2 ──
# Copiar a la instancia, NUNCA al repo:
#   scp -i ~/.ssh/omona-ec2.pem .env.production ec2-user@<EIP>:/opt/omona/.env
#   ssh ... 'chmod 600 /opt/omona/.env'

# ── Específicas de EC2 (no existían en Railway) ──
# Dominio público del API. Su registro A debe apuntar a la Elastic IP
# ANTES del primer arranque, o Caddy no obtiene certificado.
API_DOMAIN=api.omona.tech
# Correo para los avisos de expiración de Let's Encrypt.
ACME_EMAIL=victor@superleads.mx

# ── Runtime ──
PORT=8080
NODE_ENV=production

# ── OBLIGATORIAS — config.ts hace envSchema.parse(): sin estas el proceso no arranca ──
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role...
AI_API_KEY=tu-api-key

# ── Con default, pero conviene fijarlas ──
# OpenAI directo. Para volver a Azure AI:
#   AI_BASE_URL=https://TU-RECURSO.services.ai.azure.com/openai/v1
# (client.ts detecta *.azure.com y cambia el header de auth solo)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-terra
DASHBOARD_URL=https://omona.tech

# Sin efecto real: las credenciales de Baileys viven en Supabase
# (whatsapp/supabase-auth-state.ts). Se deja porque config.ts la lee.
BAILEYS_AUTH_DIR=./auth_sessions

# ── WhatsApp Cloud API ──
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=omona-verify-token

# ── Opcionales (la feature queda desactivada si faltan) ──
GROQ_API_KEY=
RESEND_API_KEY=
SUPABASE_HOOK_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=com.anthana.omona-ios
APNS_SANDBOX=
