{
  "name": "omona",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "build:server": "npm run build --workspace=apps/server",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "start": "cd apps/server && npx tsx src/index.ts"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20"
  }
}
